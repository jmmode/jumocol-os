# El MVP solo admite fixtures visuales no persistentes.
JUMOCOL_DATA_PROVIDER=fixtures

# Repositorio comercial read-only. No usar prefijo NEXT_PUBLIC_ en estas variables.
JUMOCOL_LEAD_REPOSITORY=google-sheets
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
COMMERCIAL_LEADS_SPREADSHEET_ID=1WV06WG7V4-8w2GEnYKTvnIMi3mRxVcqM2-gzPVLcPo4
COMMERCIAL_LEADS_SHEET_NAME=LEADS

# Fuente Excel TiviPlay. Se procesa solo en servidor y no se sirve desde public/.
TIVIPLAY_PAYMENTS_WORKBOOK_PATH=data/private/tiviplay/GESTION_DIA_PAGOS_2026_TIVIPLAY.xlsx

# Identidad S2: origen exacto. HTTPS obligatorio para equipos de la red.
JUMOCOL_APP_ORIGIN=http://127.0.0.1:3000
# Opcional: ruta absoluta estable y privada en el Nitro. Nunca public/.
# JUMOCOL_AUTH_DB=C:/ruta/privada/identity.sqlite

# TiviPlay Runtime/HOY/Apertura: libro GESTION_DIA_PAGOS_2026_TIVIPLAY (solo lectura, mismas credenciales de servicio).
TIVIPLAY_SPREADSHEET_ID=
# Opcional, solo validación local sin cuenta de servicio: captura de solo lectura en data/private/ (nunca en Git).
# La interfaz la rotula «CAPTURA LOCAL»; no la uses como fuente viva en JUMOCOL_HOY.
# TIVIPLAY_SHEETS_SNAPSHOT_FILE=data/private/tiviplay/sheets-snapshot.json
